# Build output. Anchored per module: an unanchored "build/" also matches source
# packages such as app/src/main/java/com/jordanmind/agent/build/, which silently
# dropped AppProjectBuilder.kt from the repository.
/build/
/app/build/
/core/build/
/desktop/build/
.gradle/
local.properties
.kotlin/

# Signing material must never be committed. Generate a release key and pass it via
# RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD.
keystore/
*.jks
*.keystore

# Large local artifacts
*.apk
*.aab
*.task
*.litertlm
*.gguf
models/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Windows packaging work directories
packaging/windows/.work/
packaging/windows/dist/
packaging/windows/JordanMind.exe
packaging/windows/.cache/
